APP_NAME=API Deteccion Antracnosis
APP_VERSION=1.2.0

SECRET_KEY=cambia-esta-clave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-este-password
ADMIN_EMAIL=admin@antracvision.com
ADMIN_FULL_NAME=Administrador

MODEL_PATH=app/models/yolov8_cls_best.pt
FRONTEND_URL=http://localhost:3000

# OpenRouter (Anthropic-compatible env names). Sin clave se usan reglas locales.
# Free text: openai/gpt-oss-20b:free | nvidia/nemotron-3-nano-30b-a3b:free | liquid/lfm-2.5-2.6b:free
# Free vision: google/gemma-4-26b-a4b-it:free | google/gemma-4-31b-it:free | nvidia/nemotron-nano-12b-v2-vl:free | openrouter/free
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=openai/gpt-oss-20b:free
ANTHROPIC_VISION_MODEL=google/gemma-4-26b-a4b-it:free
LLM_ORANGE_REJECT_THRESHOLD=0.70

# PostgreSQL 17 (Docker Compose: puerto 5433) o instancia local
DATABASE_URL=postgresql+psycopg://antracvision:antracvision@127.0.0.1:5433/antracvision
